# Variables del contenedor web (docker compose). Copiar a .env.docker.
# No subir .env.docker al repositorio: aquí van las claves reales.

DEBUG=False
# Generar una clave propia, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SECURE_SSL_REDIRECT=False

# Base de datos PostgreSQL. El servicio "db" la crea con POSTGRES_* y la
# plataforma se conecta con DB_*: deben tener los mismos valores.
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=cambia-esta-clave
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=cambia-esta-clave

# SAP en modo simulado: no se conecta a ningún servidor real.
SAP_MODO=simulado

# 1 = cargar los datos ficticios de demostración al arrancar (idempotente).
CARGAR_DEMO=1
# Contraseña de los usuarios de demostración (si se omite: la del README).
# DEMO_PASSWORD=

# Minutos de inactividad antes de cerrar la sesión.
SESION_INACTIVIDAD_MIN=30

# Correo: en la demo sale por Mailpit (servicio "mailpit" del docker compose;
# el contenedor web ya usa EMAIL_HOST=mailpit y EMAIL_PORT=1025). Los correos se
# ven en http://localhost:8025. En producción: el SMTP de la empresa.
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Plataforma GGH <no-reply@ejemplo.cl>

# region [ventas]
# --- «Enviar por correo» de nota de venta, factura y guía (HU-031 / HU-034) ---
# Mismo mecanismo que producción: con CORREO_PROVEEDOR=microsoft365 y las tres
# credenciales, el correo sale desde la casilla del vendedor por Microsoft Graph
# (registro de aplicación en Entra ID, credenciales de cliente). Con smtp, sin
# credenciales, con SAP_MODO=simulado o si Graph falla, sale por el correo de
# arriba (EMAIL_*). No escribas aquí valores reales en el ejemplo.
CORREO_PROVEEDOR=smtp
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
# Buzón desde el que sale si el vendedor del documento no tiene correo.
MS365_REMITENTE=
# PDF de facturas y guías en modo real: servicio interno de documentos que entrega
# los PDF del documento tributario (U_UrlDte). En modo simulado se genera un PDF de
# demostración y esto no se usa.
DOCUMENTOS_PDF_SERVICIO_URL=
DOCUMENTOS_PDF_SECRETO=
DOCUMENTOS_PDF_RAIZ=Anexos FE
DOCUMENTOS_PDF_HORAS=12
# endregion
