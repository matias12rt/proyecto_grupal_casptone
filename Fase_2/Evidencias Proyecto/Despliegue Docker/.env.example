# ==========================================================
# Plantilla de variables de entorno. Cópiala a .env y complétala:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux / macOS)
# El archivo .env real NO se versiona (está en .gitignore).
# ==========================================================

# --- Django ---
# En local: DEBUG=True. En producción: DEBUG=False y DJANGO_SECRET_KEY obligatoria.
DEBUG=True
# Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
# Minutos sin actividad tras los que la sesión se cierra sola (RNF-04).
SESION_INACTIVIDAD_MIN=30
# region [notificaciones]
# Minutos de espera antes del recordatorio automático a los autorizadores
# (comando enviar_recordatorios, RF-17).
RECORDATORIO_PENDIENTES_MIN=60
# endregion

# --- Base de datos ---
# Por defecto SQLite (no requiere configuración).
# Para PostgreSQL: DB_ENGINE=django.db.backends.postgresql y completa el resto.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# region [sap]
# --- SAP Business One ---
# simulado -> usa datos ficticios, no requiere acceso a SAP (recomendado para desarrollo y demo)
# real     -> se conecta al Service Layer y a la API de HANA
SAP_MODO=simulado
SAP_BASE_URL=https://servidor-sap:50000/b1s/v1
# Usuario técnico de integración (D-17): la plataforma opera con el modelo de licencias de
# acceso indirecto de SAP Business One; cada usuario que trabaja con datos de SAP tiene la suya.
SAP_USER=
SAP_PASS=
SAP_TIMEOUT=20
SAP_VERIFY_SSL=False
SAP_COMPANY=SBO_MARSELLA_TEST
SAP_COMPANY_ASLAND=SBO_ASLAND_TEST
SAP_SCHEMA_HANA=SBO_MARSELLA
SAP_SCHEMA_HANA_ASLAND=SBO_ASLAND
# Socio «CLIENTE GENERICO» de cada base, para cotizar a prospectos (HU-024)
SAP_CLIENTES_GENERICOS=C-1,C1-0

# --- API externa de consultas (carpeta api2/, FastAPI + HANA) ---
API_BASE_URL=http://127.0.0.1:8001/api
API_KEY_ID=plataforma
API_KEY_SECRET=
API_TIMEOUT=5
# endregion

# region [ventas]
# --- PDF de guías de despacho (trazabilidad de OV). Vacío = sin enlace. ---
GUIA_PDF_BASE_URL=
# endregion

# region [demo]
# --- Datos de demostración (comando cargar_datos_demo) ---
# Contraseña de los usuarios ficticios. Vacío = se usa la contraseña de demo documentada en el README.
DEMO_PASSWORD=
# endregion

# --- Correo (recuperación de contraseña y envío de documentos) ---
# Sin EMAIL_HOST los correos se imprimen en la consola. Para probar en local con
# Mailpit (docker compose up -d mailpit): EMAIL_HOST=localhost, EMAIL_PORT=1025,
# EMAIL_USE_TLS=False y abrir http://localhost:8025.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Plataforma GGH <no-reply@ejemplo.cl>

# region [ventas]
# --- «Enviar por correo» de nota de venta, factura y guía (HU-031 / HU-034) ---
# Mismo mecanismo que producción: con CORREO_PROVEEDOR=microsoft365 y las tres
# credenciales, el correo sale desde la casilla del vendedor por Microsoft Graph
# (registro de aplicación en Entra ID, credenciales de cliente). Con smtp, sin
# credenciales, con SAP_MODO=simulado o si Graph falla, sale por el correo de
# arriba (EMAIL_*). No escribas aquí valores reales en el ejemplo.
CORREO_PROVEEDOR=smtp
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
# Buzón desde el que sale si el vendedor del documento no tiene correo.
MS365_REMITENTE=
# PDF de facturas y guías en modo real: servicio interno de documentos que entrega
# los PDF del documento tributario (U_UrlDte). En modo simulado se genera un PDF de
# demostración y esto no se usa.
DOCUMENTOS_PDF_SERVICIO_URL=
DOCUMENTOS_PDF_SECRETO=
DOCUMENTOS_PDF_RAIZ=Anexos FE
DOCUMENTOS_PDF_HORAS=12
# endregion
